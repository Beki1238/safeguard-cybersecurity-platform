# ============================================================
# SafeGuard — Environment Configuration Template
# Copy this file to .env and fill in your values.
#
#   cp .env.example .env
#
# NEVER commit .env to version control.
# ============================================================

# ── Flask Core (REQUIRED) ─────────────────────────────────
# Generate a strong key with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars

# Set to "development" locally, "production" on live servers.
FLASK_ENV=development

# ── MySQL / MariaDB ───────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=safeguard_db

# ── Admin user seed ───────────────────────────────────────
# Leave blank to skip auto-creating the admin account on first run.
# Set a strong password here, run the app once to seed, then blank it out.
ADMIN_DEFAULT_PASSWORD=

# ── NVD API Key (recommended) ─────────────────────────────
# Free key at https://nvd.nist.gov/developers/request-an-api-key
# Without this: 5 NVD requests / 30s.  With it: 50 requests / 30s.
NVD_API_KEY=
